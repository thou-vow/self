[colors]
background = "#{{background}}ff"
text_primary = "#{{foreground}}ff"
text_muted = "#{{dark-foreground}}ff"
accent_primary = "#{{main-cursor}}ff"
accent_secondary = "#{{other-cursor}}ff"
warning = "#{{bright-yellow}}ff"
error = "#{{bright-red}}ff"
insert_hint = "#{{bright-aqua}}80"
backdrop = "#{{dark-background}}ff"
shadow = "#{{dark-background}}ff"


[colors.border]
focused = "#{{main-cursor}}ff"
unfocused = "#{{main-highlight}}ff"
outer = "#{{dark-background}}ff"


[colors.overview]
background_tint = "#{{dark-background}}30"
workspace_background = "#{{dark-background}}44"
badge = "#{{main-cursor}}ff"


[colors.tab_bar]
background = "#{{dark-background}}ff"
text = "#{{dark-foreground}}ff"
active = "#{{main-cursor}}ff"
active_text = "#{{dark-background}}ff"
active_unfocused = "#{{main-highlight}}ff"
active_unfocused_text = "#{{foreground}}ff"
urgent = "#{{bright-red}}ff"
urgent_text = "#{{dark-background}}ff"


[colors.title_bar]
background = "#{{main-highlight}}ff"
background_unfocused = "#{{other-highlight}}ff"
text = "#{{foreground}}ff"
text_unfocused = "#{{dark-foreground}}ff"
close = "#{{bright-red}}ff"
close_glyph = "#{{dark-background}}ff"
close_glyph_hover = "#{{dark-background}}ff"
maximize = "#{{bright-green}}ff"
maximize_glyph = "#{{dark-background}}ff"
maximize_glyph_hover = "#{{dark-background}}ff"
minimize = "#{{bright-yellow}}ff"
minimize_glyph = "#{{dark-background}}ff"
minimize_glyph_hover = "#{{dark-background}}ff"
