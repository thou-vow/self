main-highlight = "#{{main-highlight}}"
other-selection = "#{{other-selection}}"
main-selection = "#{{main-selection}}"
invisible = "#{{invisible}}"
comment = "#{{comment}}"
dark-foreground = "#{{dark-foreground}}"
foreground = "#{{foreground}}"

red = "#{{red}}"
orange = "#{{orange}}"
