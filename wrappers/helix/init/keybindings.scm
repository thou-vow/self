(define normal-mode
  (hash-union base-normal-mode
    (kv (ls 'H (ls "move_prev_sub_word_start" "collapse_selection"))
      (ls 'L (ls "move_next_sub_word_end" "collapse_selection"))
      (ls 'S-left (ls "move_prev_sub_word_start" "collapse_selection" "align_view_center" "align_view_middle"))
      (ls 'S-right (ls "move_next_sub_word_end" "collapse_selection" "align_view_center" "align_view_middle")))))

(define select-mode
  (hash-union (normal->select base-normal-mode)
    (kv (ls 'esc "normal_mode")
      (ls 'H "extend_prev_sub_word_start")
      (ls 'L "extend_next_sub_word_end")
      (ls 'left (ls "move_char_left" "align_view_center" "align_view_middle"))
      (ls 'S-left (ls "extend_prev_sub_word_start" "align_view_center" "align_view_middle"))
      (ls 'down (ls "extend_visual_line_down" "align_view_center" "align_view_middle"))
      (ls 'S-down (ls "extend_visual_line_down" "extend_visual_line_down" "align_view_center" "align_view_middle"))
      (ls 'up (ls "extend_visual_line_up" "align_view_center" "align_view_middle"))
      (ls 'S-up (ls "extend_visual_line_up" "extend_visual_line_up" "align_view_center" "align_view_middle"))
      (ls 'right (ls "extend_char_right" "align_view_center" "align_view_middle"))
      (ls 'S-right (ls "extend_next_sub_word_end" "align_view_center" "align_view_middle")))))

