(define (normal->select value)
  (define command-map
    (kv (ls "select_mode" "exit_select_mode")
      (ls "move_char_left" "extend_char_left")
      (ls "move_visual_line_down" "extend_visual_line_down")
      (ls "move_visual_line_up" "extend_visual_line_up")
      (ls "move_char_right" "extend_char_right")
      (ls "move_line_down" "extend_line_down")
      (ls "move_line_up" "extend_line_up")
      (ls "move_prev_long_word_start" "extend_prev_long_word_start")
      (ls "move_next_long_word_start" "extend_next_long_word_start")
      (ls "move_prev_long_word_end" "extend_prev_long_word_end")
      (ls "move_next_long_word_end" "extend_next_long_word_end")
      (ls "move_prev_sub_word_start" "extend_prev_sub_word_start")
      (ls "move_next_sub_word_start" "extend_next_sub_word_start")
      (ls "move_prev_sub_word_end" "extend_prev_sub_word_end")
      (ls "move_next_sub_word_end" "extend_next_sub_word_end")
      (ls "move_prev_word_start" "extend_prev_word_start")
      (ls "move_next_word_start" "extend_next_word_start")
      (ls "move_prev_word_end" "extend_prev_word_end")
      (ls "move_next_word_end" "extend_next_word_end")
      (ls "move_parent_node_start" "extend_parent_node_start")
      (ls "move_parent_node_end" "extend_parent_node_end")
      (ls "goto_first_nonwhitespace" "extend_to_first_nonwhitespace")
      (ls "goto_file_start" "extend_to_file_start")
      (ls "goto_file_end" "extend_to_file_end")
      (ls "goto_line_end" "extend_to_line_end")
      (ls "goto_last_line" "extend_to_last_line")
      (ls "find_next_char" "extend_next_char")
      (ls "find_prev_char" "extend_prev_char")
      (ls "find_till_char" "extend_till_char")
      (ls "till_prev_char" "extend_till_prev_char")
      (ls "goto_word" "extend_to_word")
      (ls "goto_line_start" "extend_to_line_start")
      (ls "goto_line_end_newline" "extend_to_line_end_newline")
      (ls "search_next" "extend_search_next")
      (ls "search_prev" "extend_search_prev")
      (ls "goto_column" "extend_to_column")))
  (define (transform-command str)
    (define new-value-or-false
      (hash-try-get command-map str))
    (if (not new-value-or-false)
      str
      new-value-or-false))
  (cond
    ((string? value)
      (transform-command value))
    ((list? value)
      (map transform-command value))
    ((hash? value)
      (transduce value
        (mapping (lambda (lst)
                  (define key (list-ref lst 0))
                  (define value (list-ref lst 1))
                  (ls key (normal->select value))))
        (into-hashmap)))
    (else value)))

