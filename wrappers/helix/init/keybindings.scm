(define keybindings
  (kv (ls 'normal normal-mode)
    (ls 'insert insert-mode)
    (ls 'select select-mode)))

(hx.cfg.set-keybindings!
  (~> keybindings
    (value->jsexpr-string)
    (hx.core.keymaps.helix-string->keymap)))

