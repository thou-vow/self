input {
    keyboard {
        xkb {
            layout "br,us"
            model "thinkpad"
            options "caps:escape_shifted_capslock,grp:win_space_toggle"
        }
        repeat-delay 200
        repeat-rate 60
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.4
        scroll-method "two-finger"
        click-method "clickfinger"
    }
    warp-mouse-to-focus mode="center-xy-always"
}
output "eDP-1" {
    mode "1366x768"
}
environment {
    NIXOS_OZONE_WL "1"
}
overview {
    backdrop-color "#060810"
}
layout {
    background-color "#121622"
    gaps 10
    focus-ring {
        width 1
        active-color "#f4dbe2"
        urgent-color "#f5b3a7"
    }
    border {
        off
    }
    shadow {
        on
        spread 25
        softness 25
    }
    tab-indicator {
        width 3
    }
    struts {
        left 11
        right 11
    }
}
prefer-no-csd
hotkey-overlay {
    hide-not-bound
    skip-at-startup
}
gestures {
    hot-corners {
        off
    }
}
binds {
    Mod+End hotkey-overlay-title="Suspend session" repeat=false {
        suspend
    }
    Mod+Shift+End hotkey-overlay-title="Quit session" repeat=false {
        quit
    }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Toggle microphone" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
    }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Toggle volume" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Decrease volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01-"
    }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Increase volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01+"
    }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" {
        spawn "brightnessctl" "set" "1%-"
    }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase brightness" {
        spawn "brightnessctl" "set" "1%+"
    }
    Print repeat=false {
        screenshot
    }
    Shift+Print repeat=false {
        screenshot-window
    }
    Mod+Return hotkey-overlay-title="Open fuzzel" repeat=false {
        spawn "fuzzel"
    }
    Mod+Equal {
        set-column-width "+5%"
    }
    Mod+Shift+Equal {
        set-window-height "+5%"
    }
    Mod+Minus {
        set-column-width "-5%"
    }
    Mod+Shift+Minus {
        set-window-height "-5%"
    }
    Mod+Tab repeat=false {
        switch-focus-between-floating-and-tiling
    }
    Mod+Q repeat=false {
        close-window
    }
    Mod+T hotkey-overlay-title="Open terminal" repeat=false {
        spawn "kitty" "-1"
    }
    Mod+W hotkey-overlay-title="Open browser" repeat=false {
        spawn "brave"
    }
    Mod+I repeat=false {
        toggle-column-tabbed-display
    }
    Mod+O repeat=false {
        toggle-overview
    }
    Mod+F repeat=false {
        toggle-window-floating
    }
    Mod+Z repeat=false {
        maximize-window-to-edges
    }
    Mod+Shift+Z repeat=false {
        fullscreen-window
    }
    Mod+C {
        center-column
    }
    Mod+M repeat=false {
        maximize-column
    }
    Mod+Shift+Slash repeat=false {
        show-hotkey-overlay
    }
    Mod+H {
        focus-column-left
    }
    Mod+Shift+H {
        move-column-left
    }
    Mod+Ctrl+H {
        consume-or-expel-window-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+Shift+J {
        move-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+Shift+K {
        move-window-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+Shift+L {
        move-column-right
    }
    Mod+Ctrl+L {
        consume-or-expel-window-right
    }
    Mod+P {
        focus-workspace-up
    }
    Mod+Shift+P {
        move-column-to-workspace-up
    }
    Mod+N {
        focus-workspace-down
    }
    Mod+Shift+N {
        move-column-to-workspace-down
    }
}
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
window-rule {
    default-column-width {
        proportion 0.5
    }
}
